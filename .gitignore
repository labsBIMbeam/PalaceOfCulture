# Dependencies
node_modules/

# Build output. Every napplet artifact is reproducible from source with
# `pnpm build`, and the published copy is addressed by hash on Blossom — a
# committed copy would only ever be a stale second truth.
dist/

# Secrets. No nsec, no nbunksec, no relay tokens, ever.
.env
.env.*
!.env.example

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
