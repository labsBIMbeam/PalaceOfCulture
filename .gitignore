coverage/

# Avatar assets (CC0 Quaternius packs/presets, VRM/FBX test assets) — fetched/dropped in, never committed
apps/web/public/avatar/

# Furniture assets (CC0 Kenney/Quaternius GLBs) — fetched/dropped in; keep CREDITS.md
apps/web/public/furniture/*.glb

# Street building assets (CC-BY/CC0 GLBs) — fetched/dropped in; keep CREDITS.md
apps/web/public/buildings/*.glb

# Street props (CC0 Kenney/Quaternius GLBs) — fetched/dropped in; keep CREDITS.md
apps/web/public/props/*.glb
apps/web/public/props/_manifest.json

# Modular house kit (CC0 Kenney City/House kit GLBs) — fetched/dropped in; keep CREDITS.md
apps/web/public/housekit/*.glb
apps/web/public/housekit/_manifest.json

# Sky HDRI (CC0 Poly Haven puresky) — fetched/dropped in, never committed
apps/web/public/sky/

# Media sample feeds (real PC2.0 RSS saved same-origin for the demo) — fetched, not committed
apps/web/public/feeds/

# Editor / OS
.DS_Store
Thumbs.db
