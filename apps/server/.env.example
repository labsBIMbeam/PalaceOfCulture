# Production stays deny-by-default. List every browser origin explicitly; wildcards are rejected.
MULTIPLAYER_ORIGINS=https://palace.example.com

# The ordinary `pnpm dev:server` command supplies both Vite loopback origins automatically.
# MULTIPLAYER_HOST=127.0.0.1
# MULTIPLAYER_PORT=2567

# For a cross-machine playtest, use root `pnpm dev:lan`; it binds multiplayer only to the explicit
# PALACE_LAN_HOST and derives the exact Windows browser origin. Do not use a wildcard origin.

# Keep zero for a directly exposed listener. Enable only behind exactly this many trusted proxies,
# with the edge stripping or overwriting client-supplied forwarding headers.
MULTIPLAYER_TRUST_PROXY_HOPS=0
