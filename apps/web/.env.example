# Unsafe demo writes use a throwaway session key and public Nostr relays. Local development only.
VITE_ENABLE_DEMO_WRITES=false

# Wallet hand-off remains development-only until BOLT11 amount/context validation lands.
VITE_ENABLE_REAL_PAYMENTS=false

# Character persistence defaults to true; set false only for onboarding tests.
VITE_PERSIST_CHARACTER=true

# Optional Colyseus matchmaking endpoint. Development defaults to http://127.0.0.1:2567; production
# defaults to the page origin for a reverse proxy. Only absolute http:// or https:// URLs are accepted.
# VITE_MULTIPLAYER_URL=https://palace.example.com

# For a Windows-browser/Linux-server playtest, prefer the root `pnpm dev:lan` launcher. It sets this
# to the selected Tailscale/LAN interface before Vite builds the development client.

# Optional FIPS mesh relay, probed at runtime and prepended to the public relays when it answers.
# Defaults to ws://localhost:7777; set empty to disable mesh routing and skip the probe entirely.
# Plaintext ws:// is restricted to loopback because an HTTPS page cannot open an insecure socket to
# anything else — point this at a local FIPS port forward, never at an fd97: mesh address.
# VITE_MESH_RELAY_URL=ws://localhost:7777
