{
  "name": "600-billion",
  "version": "0.0.0",
  "private": true,
  "description": "600 Billion — The Palace of Culture. Web-first stylized 3D social MMO built on Bitcoin timelocks.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @600b/web dev",
    "dev:server": "pnpm --filter @600b/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "test": "pnpm -r --if-present test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "set-cookie-parser": "3.1.1"
    }
  }
}
