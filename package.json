{
  "name": "palace-napplets",
  "version": "0.0.0",
  "private": true,
  "description": "The Palace UI as napplets. One panel, one napplet, portable to any NIP-5D shell.",
  "license": "MIT",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm -r verify",
    "test:conformance": "pnpm -r test:conformance",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@kehto/cli": "^0.2.16",
    "@kehto/paja": "^0.8.0",
    "typescript": "^5.9.3"
  }
}
