{
  "name": "@600b/napplet-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@napplet/sdk": "^0.28.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
